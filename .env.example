# Snowflake connection for the `snowflake` target in profiles.yml.
# Copy to .env and fill in real values:  cp .env.example .env
# .env (and *.env, *.p8) are gitignored — never commit real credentials.

# --- Required (REPLACE these dummy values) ---
SNOWFLAKE_ACCOUNT=CHANGEME-orgname-accountname   # e.g. abc12345.us-east-1
SNOWFLAKE_USER=CHANGEME_USER
SNOWFLAKE_ROLE=CHANGEME_ROLE
SNOWFLAKE_WAREHOUSE=CHANGEME_WAREHOUSE

# --- Optional (defaults shown in profiles.yml) ---
SNOWFLAKE_DATABASE=JAFFLE_SHOP
SNOWFLAKE_SCHEMA=PUBLIC

# --- Key-pair auth ---
# Path to your unencrypted-or-passphrase-protected PEM .p8 private key.
# Keep the key inside .snowflake/ (gitignored).
SNOWFLAKE_PRIVATE_KEY_PATH=.snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- QUERY_TAG (optional) ---
# Defaults to dbt's per-run invocation_id if unset. Override to tag a run so
# you can find it via Monitoring > Query History > Query Tag.
# DBT_QUERY_TAG=my-custom-tag
